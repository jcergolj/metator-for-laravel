<?php

namespace Deployer;

require 'recipe/laravel.php';
require 'contrib/php-fpm.php';

$site = require __DIR__.'/__CONFIG_FILE__';
$siteId = $site['site_id'];
$deployPath = '/var/www/'.$siteId;
$phpBinary = '/usr/bin/php'.$site['php_version'];
$workerType = $site['worker'] ?? 'none';

set('application', $siteId);
set('repository', 'git-'.$siteId.':'.$site['repository'].'.git');

set('branch', '__BRANCH__');
set('keep_releases', 5);
set('worker_type', $workerType);
set('bin/php', $phpBinary);
set('writable_dirs', ['shared/storage']);

host('production')
    ->setHostname($site['ssh']['host'])
    ->setRemoteUser($site['deploy_user'] ?? 'deployer')
    ->setDeployPath($deployPath);

/*
 * Server services are configured by scripts/server-bootstrap.sh:
 * - scheduler cron: php artisan schedule:run every minute
 * - Supervisor: either queue:work or Horizon
 */

if (($site['database'] ?? 'sqlite') === 'sqlite') {
    add('shared_files', ['database/database.sqlite']);
}

task('metator:verify-runtime', function () use ($deployPath, $phpBinary, $site) {
    $metadata = escapeshellarg($deployPath.'/.metator-site');
    $expectedVersion = escapeshellarg($site['php_version']);
    $expectedBinary = escapeshellarg($phpBinary);
    $versionExpression = escapeshellarg('echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;');
    run("test \"\$(sed -nE 's/^php_version=(.*)$/\\1/p' {$metadata})\" = {$expectedVersion}");
    run("test \"\$({$expectedBinary} -r {$versionExpression})\" = {$expectedVersion}");
});

before('deploy:prepare', 'metator:verify-runtime');

task('deploy:cache', function () {
    run('cd {{release_path}} && {{bin/php}} artisan optimize');
});

after('artisan:migrate', 'deploy:cache');

if ($workerType !== 'none') {
    task('deploy:activate-workers', function () {
        run('sudo supervisorctl update {{application}}-worker');
    });

    task('deploy:restart-workers', function () use ($workerType) {
        if ($workerType === 'horizon') {
            run('cd {{release_path}} && {{bin/php}} artisan horizon:terminate');
        } elseif ($workerType !== 'queue') {
            throw new \RuntimeException('WORKER_TYPE must be either horizon or queue');
        }
        run('sudo supervisorctl restart {{application}}-worker:*');
    });

    task('deploy:verify-workers', function () {
        run('test "$(readlink -f {{deploy_path}}/current)" = "{{release_path}}"');
        run('sudo supervisorctl status {{application}}-worker:* | grep -q RUNNING');

        $workerCommand = get('worker_type') === 'horizon' ? 'horizon' : 'queue:work';
        run("pgrep -af 'php .*{{deploy_path}}/current/artisan {$workerCommand}'");
    });

    after('deploy:symlink', 'deploy:activate-workers');
    after('deploy:activate-workers', 'deploy:restart-workers');
    after('deploy:restart-workers', 'deploy:verify-workers');
}

// If your server still requires a PHP-FPM reload after symlinking the new
// release, uncomment this hook.
// after('deploy:symlink', 'php-fpm:reload');

after('deploy:failed', 'deploy:unlock');
